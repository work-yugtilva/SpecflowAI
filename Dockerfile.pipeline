# FastAPI pipeline — build context is the **repository root** (Railway default).
# Use when the Railway service has no Root Directory set (full monorepo checkout).
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --prefer-binary -r requirements.txt

COPY backend/config ./config
COPY backend/src ./src

WORKDIR /app/src

EXPOSE 8001

CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8001}"]
