# Copy to .env.local and fill in from:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pipeline API (session + runs). Local default is FastAPI on 8001 (see CLAUDE.md).
NEXT_PUBLIC_PIPELINE_URL=http://localhost:8001
# Optional on Vercel: server-only override for Route Handlers (same value as NEXT_PUBLIC_* is fine).
# PIPELINE_SERVER_URL=https://api.example.com

# Node Express (context + research). Do not use the pipeline URL here.
# Local: Express default port. Production (SpecFlow): https://context.specflowai.com (no trailing slash). See docs/deploy/vercel-express.md
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:3001
# Optional: server-only Express origin for Next.js `/api/express/*` proxy (when the browser must not call Express directly — e.g. missing NEXT_PUBLIC_* at build or CORS). Same URL as NEXT_PUBLIC_EXPRESS_API_URL is fine.
# EXPRESS_API_URL=https://your-backend.vercel.app
# Optional: deployed fallback when Express would resolve to loopback — overrides SpecFlow default. See frontend/lib/api/express-origin.ts
# NEXT_PUBLIC_EXPRESS_FALLBACK_ORIGIN=https://context.specflowai.com
# EXPRESS_FALLBACK_ORIGIN=https://context.specflowai.com

# Public app origin (no trailing slash). OAuth redirect_uri must match Slack
# app settings exactly (scheme + host + path).
#
# Slack often requires HTTPS redirect URLs. For local dev, use a tunnel and browse the app
# on that HTTPS URL (same origin for OAuth state cookie):
#   ngrok http 3000   # or: cloudflared tunnel --url http://localhost:3000
# Then set this to the tunnel origin and add to Slack → OAuth & Permissions → Redirect URLs:
#   https://<your-tunnel-host>/api/auth/slack/callback
# NEXT_PUBLIC_APP_URL=https://xxxx.ngrok-free.app
#
# Production: your real site URL (HTTPS).
# NEXT_PUBLIC_APP_URL=https://app.example.com

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_DSN=your_sentry_dsn_here

NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
