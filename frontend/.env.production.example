# Copy to Vercel → Project → Settings → Environment Variables (Production).
# Do not commit real keys. Redeploy after changing NEXT_PUBLIC_* URLs (CSP is build-time).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI pipeline (HTTPS, no trailing slash)
NEXT_PUBLIC_PIPELINE_URL=

# Express context/research API (HTTPS, no trailing slash)
NEXT_PUBLIC_EXPRESS_API_URL=

# Optional
# NEXT_PUBLIC_SENTRY_DSN=
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
