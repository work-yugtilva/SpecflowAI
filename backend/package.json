{
  "name": "specflow-backend",
  "version": "1.0.0",
  "description": "SpecFlow backend API server",
  "main": "dist/expressEntry.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/expressEntry.ts",
    "dev:pipeline": "node scripts/run-pipeline.mjs",
    "build": "tsc && tsc-alias",
    "start": "node dist/expressEntry.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.1.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "tsx": "^3.12.7"
  }
}
