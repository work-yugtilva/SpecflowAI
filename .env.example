# ─── SpecFlow — Single Source of Truth ──────────────────────────────────────
# This is the authoritative env file for the entire monorepo.
# Both frontend (next.config.mjs) and backend (loadRootEnv.ts/load_env.py)
# load from this file. Local overrides: frontend/.env.local, backend/.env
# ────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Python FastAPI (pipeline /sessions, /session/.../run)
NEXT_PUBLIC_PIPELINE_URL=http://localhost:8001
# Node Express (context + research). Do not use the pipeline URL here.
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:3001
# Legacy: if set to :8000/:8001 by mistake, context client ignores it for /api/context
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

PORT=3001
FRONTEND_URL=http://localhost:3000
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional pipeline tuning
# PIPELINE_CONFIG_PATH=config/agents/pipeline.yaml
# AI_MODEL=claude-haiku-4-5-20251001
# AI_MAX_TOKENS=2048
# AI_RETRIES=3
