# ─── SpecFlow — Single Source of Truth ──────────────────────────────────────
# This is the authoritative env file for the entire monorepo.
# Next.js, Express, and FastAPI all load from this file.
# ────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
ENVIRONMENT=development

# Deprecated — no longer read by any runtime code; has no effect
NEXT_PUBLIC_USE_LOCAL_PIPELINE=false

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Railway FastAPI URL — set this in Vercel Environment Variables for production
# Local default is http://localhost:8000 (FastAPI dev server)
NEXT_PUBLIC_PIPELINE_URL=http://localhost:8000
# Node Express (context + research). Do not use the pipeline URL here.
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:3001
# Optional on frontend Vercel: server-only Express origin for Next.js /api/express/* proxy (same value as NEXT_PUBLIC_EXPRESS_API_URL is fine).
# EXPRESS_API_URL=http://localhost:3001
# Legacy compatibility only. Prefer NEXT_PUBLIC_EXPRESS_API_URL for context/research.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# 32-byte AES-256-GCM key for OAuth token encryption (base64-encoded)
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=

PORT=3001
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Required in production — app will refuse to start without it
# Example: https://app.specflow.ai,https://specflow.ai
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ANTHROPIC_API_KEY=your_anthropic_api_key
PIPELINE_PORT=8001

# Rate limiting (per authenticated user)
RATE_LIMIT_PIPELINE=10/hour
RATE_LIMIT_HANDOFF=20/hour
RATE_LIMIT_GENERAL=120/minute
RATE_LIMIT_EXPRESS_GENERAL=120
RATE_LIMIT_EXPRESS_RESEARCH=60
RATE_LIMIT_EXPRESS_CONTEXT=30

# Optional pipeline tuning
# PIPELINE_CONFIG_PATH=config/agents/pipeline.yaml
# AI_MODEL=claude-haiku-4-5-20251001
# AI_MAX_TOKENS=2048
# AI_RETRIES=3

# Sentry error monitoring
# SENTRY_DSN=https://...@sentry.io/...

# Linear integration
# Option A — OAuth (recommended, per-user): register a Linear OAuth app and set:
# LINEAR_CLIENT_ID=your_linear_client_id
# LINEAR_CLIENT_SECRET=your_linear_client_secret
# Callback URL to register in Linear OAuth app settings:
#   http://localhost:3000/api/auth/linear/callback  (dev)
#   https://your-domain.com/api/auth/linear/callback  (prod)
#
# Option B — static API key (fallback for local dev / single-user setups):
# LINEAR_API_KEY=lin_api_YOUR_KEY_HERE

# Stripe billing
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
# Stripe webhook must listen for: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE
STRIPE_PRO_PRICE_ID=price_YOUR_PRO_PRICE_ID
STRIPE_TEAM_PRICE_ID=price_YOUR_TEAM_PRICE_ID
